msgid "plugins.generic.kisiZenodo.displayName"
msgstr "Kisi Zenodo DOI Integration"

msgid "plugins.generic.kisiZenodo.description"
msgstr "Automates 2-stage Zenodo DOI pre-reservation (Production DOCX draft) and final PDF Galley deposit into your Zenodo Community via the InvenioRDM REST API."

msgid "plugins.generic.kisiZenodo.managerAction"
msgstr "Zenodo DOI Manager"

